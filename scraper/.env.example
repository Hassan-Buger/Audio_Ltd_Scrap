# Environment configuration for Audiovideo.lt Scraper
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Application & API
HOST=0.0.0.0
PORT=8000
API_KEY=test-operator-api-key-change-in-production
SECRET_KEY=change-me-to-a-secure-secret-key-in-production
ALLOWED_ORIGINS=*

# Database
# For local development with SQLite fallback if Postgres is not running:
# DATABASE_URL=sqlite:///./audiovideo.db
# For PostgreSQL (Railway / Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiovideo

# Task Broker / Redis
REDIS_URL=redis://localhost:6379/0

# Scraper Settings
TARGET_ALLOWED_HOSTS=www.audiovideo.lt,audiovideo.lt
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
CRAWL_CONCURRENCY=2
CRAWL_DOWNLOAD_DELAY=2.0
CRAWL_MAX_RETRIES=3
CRAWL_MAX_DEPTH=10
CRAWL_MAX_URLS_PER_JOB=50000
USE_PLAYWRIGHT_FALLBACK=false

# Translation
TRANSLATION_ENABLED=false
TRANSLATION_PROVIDER=none
