# Environment configuration for Audiovideo.lt Scraper
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Application & API
HOST=0.0.0.0
PORT=8000
# Operator API key. No usable default is provided here: set API_KEY in your
# Railway environment variables (required in production). Local development
# falls back to a dev-only value defined in app/config.py.
# API_KEY=set-via-railway-environment-variable
SECRET_KEY=change-me-to-a-secure-secret-key-in-production
# Explicit CORS allowlist (production should list the Railway host(s)).
# Local development includes http://localhost:8000.
ALLOWED_ORIGINS=http://localhost:8000,https://audioltdscrap-production.up.railway.app

# Database
# For local development with SQLite fallback if Postgres is not running:
# DATABASE_URL=sqlite:///./audiovideo.db
# For PostgreSQL (Railway / Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiovideo

# Task Broker / Redis
REDIS_URL=redis://localhost:6379/0

# Scraper Settings
TARGET_ALLOWED_HOSTS=www.audiovideo.lt,audiovideo.lt
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Optional cf_clearance or session cookies from an authorized browser session:
# SCRAPER_COOKIES=cf_clearance=your_cf_clearance_token_here
CRAWL_CONCURRENCY=2
CRAWL_DOWNLOAD_DELAY=2.0
CRAWL_MAX_RETRIES=3
CRAWL_MAX_DEPTH=10
CRAWL_MAX_URLS_PER_JOB=50000
USE_PLAYWRIGHT_FALLBACK=false

# Translation
TRANSLATION_ENABLED=false
TRANSLATION_PROVIDER=none
